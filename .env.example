# Copy to .env and fill in. Never commit .env.
#
# Note: the Firebase client values below are NOT secrets. They ship in the browser bundle by design.
# The security boundary is the Firestore rules file (docs/adr/0005). Keep real secrets out of this
# file entirely.
#
# There is no backend and no push (docs/adr/0006), so nothing here is needed to run the app locally.
# These values are only for cloud sync (Workflow S), which ships OFF by default.

# --- Firebase (client config; safe to expose) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firestore emulator (local tests only) ---
# host or host:port, e.g. 127.0.0.1:8080. Leave empty for a real deployment.
#
# Deliberately NOT named after a credential. It is a host and a port, and a name containing KEY,
# SECRET or TOKEN is how a real secret ends up in a client bundle. Firestore and Auth are emulated on
# the same host; the client derives both ports from this value.
VITE_FIREBASE_EMULATOR_HOST=

# --- Auth allow-list (single user) ---
# Her email address. This value is for display/UX only — it authorises NOTHING. The Firestore rules
# file is the security boundary, and its email constant is the one that has to match; a client value
# cannot grant access (docs/adr/0005). Both files ship with a placeholder.
VITE_ALLOWED_EMAIL=

# --- Cloud sync. Ships OFF; milestone 2b owns the sign-in and status UI that switches it on. ---
VITE_ENABLE_CLOUD_SYNC=false

# Removed: VITE_VAPID_PUBLIC_KEY and VITE_PUSH_API_URL.
# Notification delivery is in-app only (docs/adr/0006-in-app-notifications-only.md) — there is no
# push service to configure, and no server-side secret anywhere in this project.
