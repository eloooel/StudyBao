# Copy to .env and fill in. Never commit .env.
#
# Note: the Firebase client values below are NOT secrets. They ship in the browser bundle by design.
# The security boundary is the Firestore rules file (docs/adr/0005). Keep real secrets out of this
# file entirely — the VAPID private key belongs only in the push backend's deploy secrets.

# --- Firebase (client config; safe to expose) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Auth allow-list (single user) ---
VITE_ALLOWED_EMAIL=

# --- Push backend ---
# Public key only. The matching private key lives in the backend's deploy secrets (never here).
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_API_URL=

# --- Optional ---
# Enable cloud sync locally. Defaults to off so the app is fully usable with no backend.
VITE_ENABLE_CLOUD_SYNC=false
