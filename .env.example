# Copy to .env and fill in. Never commit .env.
#
# Note: the Firebase client values below are NOT secrets. They ship in the browser bundle by design.
# The security boundary is the Firestore rules file (docs/adr/0005). Keep real secrets out of this
# file entirely.
#
# THIS FILE IS MOSTLY INERT. There is no backend and no push (docs/adr/0006), so nothing here is
# needed to run the app locally — it is only for the optional cloud-sync path, which is off by
# default. If cloud sync is never enabled, these can all be deleted.

# --- Firebase (client config; safe to expose). Only needed if VITE_ENABLE_CLOUD_SYNC=true ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Auth allow-list (single user), only if cloud sync is enabled ---
VITE_ALLOWED_EMAIL=

# --- Optional cloud sync. Defaults to off so the app is fully usable with no account. ---
VITE_ENABLE_CLOUD_SYNC=false

# Removed: VITE_VAPID_PUBLIC_KEY and VITE_PUSH_API_URL.
# Notification delivery is in-app only (docs/adr/0006-in-app-notifications-only.md) — there is no
# push service to configure, and no server-side secret anywhere in this project.

