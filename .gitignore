# Dependencies
node_modules/
.pnpm-store/

# Local npm cache. The sandboxed dev environment cannot write to the global cache
# outside the workspace, so installs are run with `--cache ./.npm-cache`. Safe to
# delete; it is only a package cache.
.npm-cache/

# Build output
dist/
dist-ssr/
build/
*.local

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
vapid*.json
service-account*.json

# Test and coverage
coverage/
.vitest/
playwright-report/
test-results/

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# PWA build artifacts
dev-dist/
public/sw.js
public/workbox-*.js

# Vendored third-party runtime assets.
#
# `public/pdfjs/` is generated from node_modules by scripts/copy-pdf-assets.mjs, and copying
# 2 MB of worker and wasm into git would be a diff nobody reads and a blob everyone downloads.
# It is regenerated by `predev`/`prebuild` from a normal `npm install`.
public/pdfjs/
public/ocr/

# ...with one exception: the language data is NOT reproducible from node_modules, so unlike the
# rest it is committed. Denying it would mean the build needs the network to produce an
# offline-capable app, which the C brief calls out as a contradiction. It is 1.87 MB, pinned to
# a tessdata_fast commit, and its sha256 is recorded in scripts/vendor-ocr-lang.mjs.
!public/ocr/lang/
!public/ocr/lang/eng.traineddata.gz

# Test-only inputs and outputs for the PDF smoke check (scripts/make-test-pdf.mjs).
.pdf-smoke.pdf

# One-off commit-message files used while writing multi-paragraph commits.
.git-commit-msg*.txt

# Firebase / Cloudflare local state
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
.wrangler/
