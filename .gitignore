# Dependencies
node_modules/
.pnpm-store/

# Local npm cache. The sandboxed dev environment cannot write to the global cache
# outside the workspace, so installs are run with `--cache ./.npm-cache`. Safe to
# delete; it is only a package cache.
.npm-cache/

# Build output
dist/
dist-ssr/
build/
*.local

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
vapid*.json
service-account*.json

# Test and coverage
coverage/
.vitest/
playwright-report/
test-results/

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# PWA build artifacts
dev-dist/
public/sw.js
public/workbox-*.js

# Vendored third-party runtime assets, written by scripts/copy-pdf-assets.mjs (and the OCR
# asset script in Workflow C commit 3) from node_modules. Generated, not source: copying
# 2 MB of PDF.js worker and wasm into git would be a diff nobody reads and a blob everyone
# downloads. `npm install` plus those scripts reproduce them exactly, and the scripts run
# automatically from `predev`/`prebuild`.
public/pdfjs/
public/ocr/

# Test-only inputs and outputs for the PDF smoke check (scripts/make-test-pdf.mjs).
.pdf-smoke.pdf

# Firebase / Cloudflare local state
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
.wrangler/
