# Dependencies
node_modules/
.pnpm-store/

# Local npm cache. The sandboxed dev environment cannot write to the global cache
# outside the workspace, so installs are run with `--cache ./.npm-cache`. Safe to
# delete; it is only a package cache.
.npm-cache/

# Build output
dist/
dist-ssr/
build/
*.local

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
vapid*.json
service-account*.json

# Test and coverage
coverage/
.vitest/
playwright-report/
test-results/

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# PWA build artifacts
dev-dist/
public/sw.js
public/workbox-*.js

# Firebase / Cloudflare local state
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
.wrangler/
