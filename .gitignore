# Dependencies
node_modules/
.pnpm-store/

# Local npm cache. The sandboxed dev environment cannot write to the global cache
# outside the workspace, so installs are run with `--cache ./.npm-cache`. Safe to
# delete; it is only a package cache.
.npm-cache/

# Build output
dist/
dist-ssr/
build/
*.local

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
vapid*.json
service-account*.json

# Test and coverage
coverage/
.vitest/
playwright-report/
test-results/

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# PWA build artifacts
dev-dist/
public/sw.js
public/workbox-*.js

# Vendored third-party runtime assets.
#
# These are generated from node_modules by `npm run assets` (run by predev/prebuild), so they are
# not source: ~45 MB of vendored WebAssembly in git would be a diff nobody reads and a blob
# everyone downloads, and a normal `npm install` reproduces them exactly.
#
# NOTE the `/*` suffix rather than a bare directory. `public/ocr/` would exclude the whole
# directory, and **git cannot re-include a file whose parent directory is excluded** — so the
# `!public/ocr/lang/...` negation below silently did nothing, and the language data was left
# untracked even though it must be committed. Excluding the directory's *contents* keeps the
# negation able to work.
public/pdfjs/*
public/ocr/*

# The language data is the exception, and it is deliberate: it cannot be derived from
# node_modules, so committing it is what stops the build needing the network to produce an
# offline-capable app — which the C brief calls out as a contradiction. It is 1,962,155 bytes,
# pinned to a tessdata_fast commit, and its sha256 is recorded in scripts/vendor-ocr-lang.mjs.
!public/ocr/lang/
!public/ocr/lang/eng.traineddata.gz

# Test-only inputs and outputs for the PDF smoke check (scripts/make-test-pdf.mjs).
.pdf-smoke.pdf

# One-off commit-message files used while writing multi-paragraph commits.
.git-commit-msg*.txt

# Firebase / Cloudflare local state
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
.wrangler/
