{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:check)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:run)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npx vitest run*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm run deploy*)",
      "Bash(firebase deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(git push*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/vapid*.json)",
      "Read(./**/service-account*.json)",
      "Bash(curl*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ]
  }
}
