# Normalize line endings: LF in the repository, native on checkout.
# This repo is authored on Windows and consumed on a phone; mixed endings cause
# spurious diffs and can break the service worker's byte-level asset hashing.
* text=auto eol=lf

# Text formats that must always be LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Windows-only scripts
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets — never normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.icns   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.wasm   binary
*.gz     binary
# Tesseract language data — large, binary, and must never be line-ending mangled
*.traineddata binary

# Generated files: keep them out of diff noise
package-lock.json -diff
dist/**           linguist-generated=true
public/sw.js      linguist-generated=true
public/workbox-*  linguist-generated=true
